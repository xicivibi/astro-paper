{
  "name": "astro-paper-v6",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/check-post-quality.mjs && astro check && astro build && node scripts/copy-deployment-files.mjs && pagefind --site dist && node scripts/copy-pagefind.mjs && node scripts/adsense-readiness.mjs",
    "preview": "astro preview",
    "sync": "astro sync",
    "astro": "astro",
    "test": "node --experimental-strip-types --test --test-concurrency=1 tests/*.test.ts",
    "check": "astro check",
    "check:posts": "node scripts/check-post-quality.mjs",
    "sign:post": "node scripts/sign-post.mjs",
    "check:adsense": "node scripts/adsense-readiness.mjs",
    "format:check": "prettier --check .",
    "format:changed": "node scripts/check-changed-format.mjs",
    "format": "prettier --write .",
    "lint": "eslint .",
    "release:cloudflare": "node scripts/release-cloudflare.mjs",
    "redirects:vercel": "node scripts/generate-vercel-redirects.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^5.0.6",
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.2",
    "@tailwindcss/vite": "^4.3.0",
    "astro": "^6.3.3",
    "dayjs": "^1.11.20",
    "lodash.kebabcase": "^4.1.1",
    "remark-collapse": "^0.1.2",
    "remark-toc": "^9.0.0",
    "satori": "^0.26.0",
    "sharp": "^0.34.5",
    "slugify": "^1.6.9",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@pagefind/default-ui": "^1.5.2",
    "@shikijs/transformers": "^4.0.2",
    "@tailwindcss/typography": "^0.5.19",
    "@types/lodash.kebabcase": "^4.1.9",
    "@typescript-eslint/parser": "^8.59.3",
    "eslint": "^10.4.0",
    "eslint-plugin-astro": "^1.7.0",
    "pagefind": "^1.5.2",
    "prettier": "3.8.3",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "typescript": "^6.0.3"
  }
}
