---
import type { CollectionEntry } from "astro:content";
import { getPostUrl } from "@/utils/getPostPaths";
import Datetime from "./Datetime.astro";

type Props = CollectionEntry<"posts">;

const { id, data, filePath } = Astro.props;
const { title, description, tags = [], ...props } = data;
---

<li class="border-border border-b py-5 first:pt-0 last:border-b-0">
  <div class="grid gap-3 sm:grid-cols-[9rem_1fr]">
    <div class="text-muted-foreground text-sm">
      <Datetime {...props} />
    </div>
    <div>
      <a
        href={getPostUrl(id, filePath, Astro.currentLocale)}
        class="hover:text-accent text-xl leading-8 font-semibold no-underline"
      >
        {title}
      </a>
      <p class="text-muted-foreground mt-2 leading-7">{description}</p>
      {
        tags.length > 0 && (
          <div class="mt-3 flex flex-wrap gap-2">
            {tags.slice(0, 4).map(tag => (
              <span class="text-muted-foreground text-xs font-semibold">#{tag}</span>
            ))}
          </div>
        )
      }
    </div>
  </div>
</li>
