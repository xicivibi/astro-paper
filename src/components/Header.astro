---
import { getRelativeLocaleUrl } from "astro:i18n";
import IconSearch from "@/assets/icons/IconSearch.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import IconMoon from "@/assets/icons/IconMoon.svg";
import { stripBase, stripLocale } from "@/utils/withBase";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { site, features } = config;
const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const relativePath = stripBase(Astro.url.pathname);
const pathWithoutTrailingSlash =
  relativePath.endsWith("/") && relativePath !== "/"
    ? relativePath.slice(0, -1)
    : relativePath;
const currentPath = stripLocale(pathWithoutTrailingSlash, locale);

const isActive = (path: string) => {
  const currentPathArray = currentPath.split("/").filter(p => p.trim());
  const pathArray = path.split("/").filter(p => p.trim());
  return currentPath === path || currentPathArray[0] === pathArray[0];
};

const navItems = [
  { href: getRelativeLocaleUrl(locale, "posts"), label: "최신글", active: isActive("/posts") && !isActive("/posts/list") },
  { href: getRelativeLocaleUrl(locale, "posts/list"), label: "리스트", active: isActive("/posts/list") },
  { href: getRelativeLocaleUrl(locale, "tags"), label: "태그", active: isActive("/tags") },
  { href: getRelativeLocaleUrl(locale, "about"), label: "소개", active: isActive("/about") },
];
---

<a
  id="skip-to-content"
  href="#main-content"
  class="absolute inset-s-4 -top-full z-50 bg-background px-3 py-2 text-accent transition-all focus:top-4"
>
  {t.a11y.skipToContent}
</a>

<header class="border-b border-[#d95f00] bg-[#ff6600] text-[#111827]">
  <div class="app-layout flex flex-wrap items-center gap-x-4 gap-y-2 py-2 text-[13px] leading-6">
    <a
      href={getRelativeLocaleUrl(locale, "")}
      class="font-bold tracking-tight no-underline hover:text-black"
      aria-label={`${site.title} 홈`}
    >
      {site.title}
    </a>

    <nav class="flex flex-wrap items-center gap-x-1 gap-y-1" aria-label="주요 메뉴">
      {navItems.map(item => (
        <a
          href={item.href}
          class:list={[
            "px-2 py-0.5 font-semibold no-underline hover:bg-black/10",
            { "bg-black/15": item.active },
          ]}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="ms-auto flex items-center gap-1">
      {features.search !== false && (
        <a
          href={getRelativeLocaleUrl(locale, "search")}
          class:list={[
            "inline-flex size-7 items-center justify-center no-underline hover:bg-black/10",
            { "bg-black/15": isActive("/search") },
          ]}
          title={t.nav.search}
          aria-label={t.nav.search}
        >
          <IconSearch class="size-4" />
        </a>
      )}

      {features.lightAndDarkMode && (
        <button
          id="theme-btn"
          class="relative size-7 p-1 hover:bg-black/10"
          title={t.a11y.toggleTheme}
          aria-label="auto"
          aria-live="polite"
        >
          <IconMoon class="absolute top-1/2 left-1/2 size-4 translate-[-50%] scale-100 rotate-0 transition-all dark:scale-0 dark:-rotate-90" />
          <IconSunHigh class="absolute top-1/2 left-1/2 size-4 translate-[-50%] scale-0 rotate-90 transition-all dark:scale-100 dark:rotate-0" />
        </button>
      )}
    </div>
  </div>
</header>
