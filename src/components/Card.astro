---
import type { CollectionEntry } from "astro:content";
import { getPostUrl } from "@/utils/getPostPaths";
import { slugifyStr } from "@/utils/slugify";
import Datetime from "./Datetime.astro";

type Props = {
  variant?: "h2" | "h3";
} & CollectionEntry<"posts">;

const { variant: Heading = "h2", id, data, filePath } = Astro.props;
const { title, description, tags = [], ...props } = data;
const previewTags = tags.slice(0, 3);
const text = `${title} ${description} ${tags.join(" ")}`.toLowerCase();
const hue =
  [...text].reduce((total, character) => total + character.charCodeAt(0), 0) %
  360;
---

<li
  class="group overflow-hidden rounded-[1.15rem] border border-border bg-background transition-colors hover:border-accent/60"
>
  <a
    href={getPostUrl(id, filePath, Astro.currentLocale)}
    class="block no-underline"
    aria-label={title}
  >
    <div class="relative aspect-[16/10] overflow-hidden bg-muted">
      <div
        role="img"
        aria-label={`${title} 콘텐츠 미리보기`}
        class="card-cover size-full transition duration-300 group-hover:scale-[1.03]"
        style={`--cover-hue: ${hue}`}
      >
        <span aria-hidden="true">콘텐츠 미리보기</span>
      </div>
      <div
        class="absolute inset-0 bg-gradient-to-t from-black/35 via-transparent to-transparent"
      >
      </div>
    </div>
    <div class="p-5">
      <Heading
        transition:name={slugifyStr(title.replaceAll(".", "-"))}
        class="group-hover:text-accent text-lg leading-7 font-semibold"
      >
        {title}
      </Heading>
      <div class="text-muted-foreground mt-3 text-sm">
        <Datetime {...props} />
      </div>
      <p class="text-muted-foreground mt-3 line-clamp-3 leading-7">
        {description}
      </p>
      {
        previewTags.length > 0 && (
          <div class="mt-4 flex flex-wrap gap-2">
            {previewTags.map(tag => (
              <span class="border-border bg-muted/60 rounded-lg border px-2 py-1 text-xs font-semibold">
                {tag}
              </span>
            ))}
          </div>
        )
      }
    </div>
  </a>
</li>
