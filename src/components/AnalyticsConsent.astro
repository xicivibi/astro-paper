---
import { monetization } from "@/config/monetization";
import config from "@/config";
---

{
  monetization.analyticsEnabled && (
    <aside
      id="xici-analytics-consent"
      data-measurement-id={monetization.measurementId}
      data-production-origin={new URL(config.site.url).origin}
      class="border-border bg-background fixed inset-x-4 bottom-4 z-50 mx-auto max-w-xl rounded-lg border p-4 shadow-lg"
      aria-label="방문 통계 선택"
      hidden
    >
      <p>
        사이트 개선을 위한 Google Analytics 방문 통계를 허용하시겠습니까?
        거절해도 글을 읽을 수 있습니다.
      </p>
      <p class="mt-2 text-sm">
        <a class="underline" href="/privacy/">
          수집 항목과 선택 변경 안내
        </a>
      </p>
      <div class="mt-3 flex flex-wrap gap-4">
        <button
          type="button"
          data-analytics-choice="granted"
          class="rounded border px-3 py-2"
        >
          허용
        </button>
        <button
          type="button"
          data-analytics-choice="denied"
          class="rounded border px-3 py-2"
        >
          거절
        </button>
      </div>
    </aside>
  )
}
<script>
  import { installAnalytics } from "@/scripts/analytics-browser";
  installAnalytics(window, document);
</script>
