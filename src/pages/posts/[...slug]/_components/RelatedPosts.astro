---
import type { CollectionEntry } from "astro:content";
import ListCard from "@/components/ListCard.astro";

type Props = {
  posts: CollectionEntry<"posts">[];
};

const { posts } = Astro.props;
---

{
  posts.length > 0 && (
    <section aria-labelledby="related-posts-title" class="mt-8">
      <h2 id="related-posts-title" class="text-xl font-bold">
        관련 글
      </h2>
      <ul class="mt-4">
        {posts.map(post => (
          <ListCard {...post} />
        ))}
      </ul>
    </section>
  )
}
