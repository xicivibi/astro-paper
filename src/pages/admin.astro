---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";
---

<Layout title={`관리 | ${config.site.title}`} description="초안, 발행글, 복구함, 사이트 UI 설정을 제어하는 관리자 콘솔입니다.">
  <Fragment slot="head"><meta name="robots" content="noindex,nofollow" /></Fragment>
  <Header />

  <main id="main-content" class="mx-auto w-full max-w-7xl px-4 py-8">
    <section class="rounded-2xl border border-border bg-background p-5 shadow-sm sm:p-7">
      <p class="text-accent text-xs font-bold tracking-[0.2em] uppercase">Private Admin</p>
      <div class="mt-3 flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
        <div>
          <h1 class="text-3xl font-bold tracking-tight sm:text-5xl">운영 관리자</h1>
          <p class="text-muted-foreground mt-4 max-w-3xl leading-8">
            발행글, 초안, 복구함, 사이트 UI 설정을 한곳에서 제어합니다. 체크박스로 여러 글을 선택해 숨김, 공개, 삭제, 복구, 초안 일괄 발행을 처리할 수 있습니다.
          </p>
        </div>
        <div class="rounded-xl border border-border bg-muted/40 px-4 py-3 text-sm text-muted-foreground">
          <strong class="text-foreground">보안:</strong> 운영 데이터와 수정 작업은 BLOG_API_KEY 검증 후에만 열립니다.
        </div>
      </div>
    </section>

    <section id="lockPanel" class="mt-6 rounded-2xl border border-border bg-background p-5 shadow-sm sm:p-6">
      <h2 class="text-xl font-bold">관리자 잠금 해제</h2>
      <p class="text-muted-foreground mt-2 leading-7">FastAPI 백엔드와 API 키를 검증해야 글 목록과 설정 화면을 볼 수 있습니다.</p>
      <div class="mt-5 grid gap-3 lg:grid-cols-[1fr_1fr_auto]">
        <div>
          <label class="text-sm font-semibold text-muted-foreground" for="apiBase">Backend URL</label>
          <input id="apiBase" class="mt-2 w-full rounded-xl border border-border bg-background px-3 py-2" value="http://127.0.0.1:8080" />
        </div>
        <div>
          <label class="text-sm font-semibold text-muted-foreground" for="apiKey">BLOG_API_KEY</label>
          <input id="apiKey" type="password" class="mt-2 w-full rounded-xl border border-border bg-background px-3 py-2" placeholder="API Key" />
        </div>
        <button id="unlockBtn" class="self-end rounded-xl bg-accent px-5 py-2.5 font-bold text-accent-foreground">잠금 해제</button>
      </div>
      <p id="lockStatus" class="mt-4 min-h-6 text-sm text-muted-foreground"></p>
    </section>

    <section id="adminConsole" class="mt-6 hidden">
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        <div class="rounded-2xl border border-border bg-background p-4 shadow-sm"><p class="text-muted-foreground text-sm font-semibold">현재 탭</p><p id="statMode" class="mt-2 text-2xl font-bold">발행글</p></div>
        <div class="rounded-2xl border border-border bg-background p-4 shadow-sm"><p class="text-muted-foreground text-sm font-semibold">표시 항목</p><p id="statCount" class="mt-2 text-2xl font-bold">0</p></div>
        <div class="rounded-2xl border border-border bg-background p-4 shadow-sm"><p class="text-muted-foreground text-sm font-semibold">선택 항목</p><p id="statSelected" class="mt-2 text-2xl font-bold">0</p></div>
        <div class="rounded-2xl border border-border bg-background p-4 shadow-sm"><p class="text-muted-foreground text-sm font-semibold">현재 글자 수</p><p id="statChars" class="mt-2 text-2xl font-bold">0</p></div>
      </div>

      <div class="mt-5 flex flex-wrap gap-2">
        <button data-tab="published" class="tabBtn rounded-xl bg-accent px-4 py-2 text-sm font-bold text-accent-foreground">발행글</button>
        <button data-tab="drafts" class="tabBtn rounded-xl border border-border px-4 py-2 text-sm font-bold">초안</button>
        <button data-tab="trash" class="tabBtn rounded-xl border border-border px-4 py-2 text-sm font-bold">복구함</button>
        <button data-tab="site" class="tabBtn rounded-xl border border-border px-4 py-2 text-sm font-bold">사이트 설정</button>
        <button id="refreshBtn" class="rounded-xl border border-border px-4 py-2 text-sm font-bold">새로고침</button>
        <button id="lockAgainBtn" class="rounded-xl border border-red-400 px-4 py-2 text-sm font-bold text-red-500">잠금</button>
      </div>

      <p id="status" class="mt-4 min-h-6 rounded-xl border border-border bg-muted/35 px-4 py-3 text-sm text-muted-foreground">대기 중</p>

      <div id="contentPanel" class="mt-5 grid gap-5 lg:grid-cols-[420px_1fr]">
        <aside class="rounded-2xl border border-border bg-background p-4 shadow-sm">
          <div class="flex items-center justify-between gap-3">
            <h2 id="listTitle" class="text-lg font-bold">발행글</h2>
            <button id="newBtn" class="rounded-xl border border-border px-3 py-2 text-sm font-bold">새 초안</button>
          </div>
          <div class="mt-3 flex gap-2">
            <input id="searchInput" class="w-full rounded-xl border border-border bg-background px-3 py-2 text-sm" placeholder="제목, 파일명, 태그 검색" />
            <button id="searchBtn" class="rounded-xl border border-border px-3 py-2 text-sm font-bold">검색</button>
          </div>
          <div id="bulkBar" class="mt-4 rounded-xl border border-border bg-muted/35 p-3">
            <label class="flex items-center gap-2 text-sm font-bold">
              <input id="selectAll" type="checkbox" class="size-4 accent-current" />
              현재 목록 전체 선택
            </label>
            <div class="mt-3 flex flex-wrap gap-2">
              <button id="bulkHideBtn" class="bulkPublished rounded-lg border border-amber-400 px-3 py-2 text-xs font-bold text-amber-600">선택 숨김</button>
              <button id="bulkShowBtn" class="bulkPublished rounded-lg border border-border px-3 py-2 text-xs font-bold">선택 공개</button>
              <button id="bulkDeletePublishedBtn" class="bulkPublished rounded-lg border border-red-400 px-3 py-2 text-xs font-bold text-red-500">선택 삭제</button>
              <button id="bulkPublishDraftBtn" class="bulkDraft rounded-lg bg-accent px-3 py-2 text-xs font-bold text-accent-foreground">선택 발행</button>
              <button id="bulkDeleteDraftBtn" class="bulkDraft rounded-lg border border-red-400 px-3 py-2 text-xs font-bold text-red-500">선택 삭제</button>
              <button id="bulkRestoreBtn" class="bulkTrash rounded-lg border border-amber-400 px-3 py-2 text-xs font-bold text-amber-600">선택 복구</button>
            </div>
          </div>
          <div id="articleList" class="mt-4 max-h-[660px] space-y-2 overflow-auto pr-1"></div>
        </aside>

        <section class="rounded-2xl border border-border bg-background p-4 shadow-sm sm:p-5">
          <div class="grid gap-3 sm:grid-cols-[1fr_1fr]">
            <div><label class="block text-sm font-semibold text-muted-foreground" for="keyword">제목 / 키워드</label><input id="keyword" class="mt-2 w-full rounded-xl border border-border bg-background px-3 py-2" placeholder="글 제목 또는 키워드" /></div>
            <div><label class="block text-sm font-semibold text-muted-foreground" for="tags">태그</label><input id="tags" class="mt-2 w-full rounded-xl border border-border bg-background px-3 py-2" placeholder="쉼표로 구분" /></div>
          </div>
          <label class="mt-4 block text-sm font-semibold text-muted-foreground" for="description">Description</label>
          <input id="description" class="mt-2 w-full rounded-xl border border-border bg-background px-3 py-2" placeholder="검색 결과에 보일 설명" />
          <label class="mt-4 block text-sm font-semibold text-muted-foreground" for="currentPath">파일 경로</label>
          <input id="currentPath" class="mt-2 w-full rounded-xl border border-border bg-muted/40 px-3 py-2 text-sm text-muted-foreground" readonly />

          <div class="mt-4 flex flex-wrap gap-2">
            <button id="savePublishedBtn" class="actionPublished rounded-xl bg-accent px-3 py-2 text-sm font-bold text-accent-foreground">발행글 수정 저장</button>
            <button id="hidePublishedBtn" class="actionPublished rounded-xl border border-amber-400 px-3 py-2 text-sm font-bold text-amber-600">공개 숨김</button>
            <button id="showPublishedBtn" class="actionPublished rounded-xl border border-border px-3 py-2 text-sm font-bold">다시 공개</button>
            <button id="deletePublishedBtn" class="actionPublished rounded-xl border border-red-400 px-3 py-2 text-sm font-bold text-red-500">파일 삭제</button>
            <button id="saveDraftBtn" class="actionDraft rounded-xl bg-accent px-3 py-2 text-sm font-bold text-accent-foreground">초안 수정 저장</button>
            <button id="createDraftBtn" class="actionDraft rounded-xl border border-border px-3 py-2 text-sm font-bold">새 초안 저장</button>
            <button id="publishBtn" class="actionDraft rounded-xl border border-border px-3 py-2 text-sm font-bold">승인 발행</button>
            <button id="deleteDraftBtn" class="actionDraft rounded-xl border border-red-400 px-3 py-2 text-sm font-bold text-red-500">초안 삭제</button>
            <button id="restoreDraftBtn" class="actionTrash rounded-xl border border-amber-400 px-3 py-2 text-sm font-bold text-amber-600">복구</button>
            <button id="previewBtn" class="rounded-xl border border-border px-3 py-2 text-sm font-bold">미리보기</button>
          </div>
          <textarea id="markdown" class="mt-4 min-h-[640px] w-full rounded-xl border border-border bg-background px-4 py-3 font-mono text-sm leading-7" spellcheck="false" placeholder="왼쪽 목록에서 글을 선택하거나 새 초안을 작성하세요."></textarea>
        </section>
      </div>

      <section id="sitePanel" class="mt-5 hidden rounded-2xl border border-border bg-background p-5 shadow-sm">
        <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
          <div><h2 class="text-xl font-bold">사이트 UI / UX 설정</h2><p class="text-muted-foreground mt-2 leading-7">저장하면 GitHub에 커밋되고 Vercel이 자동 재배포합니다.</p></div>
          <div class="flex gap-2"><button id="loadSiteBtn" class="rounded-xl border border-border px-4 py-2 text-sm font-bold">설정 불러오기</button><button id="saveSiteBtn" class="rounded-xl bg-accent px-4 py-2 text-sm font-bold text-accent-foreground">설정 저장</button></div>
        </div>
        <div class="mt-5 grid gap-4 lg:grid-cols-2">
          <div><label class="text-sm font-semibold text-muted-foreground" for="siteTitle">사이트 이름</label><input id="siteTitle" class="mt-2 w-full rounded-xl border border-border bg-background px-3 py-2" /></div>
          <div><label class="text-sm font-semibold text-muted-foreground" for="siteAuthor">작성자 / 브랜드</label><input id="siteAuthor" class="mt-2 w-full rounded-xl border border-border bg-background px-3 py-2" /></div>
          <div class="lg:col-span-2"><label class="text-sm font-semibold text-muted-foreground" for="siteDescription">사이트 설명</label><input id="siteDescription" class="mt-2 w-full rounded-xl border border-border bg-background px-3 py-2" /></div>
          <div><label class="text-sm font-semibold text-muted-foreground" for="siteUrl">사이트 URL</label><input id="siteUrl" class="mt-2 w-full rounded-xl border border-border bg-background px-3 py-2" /></div>
          <div><label class="text-sm font-semibold text-muted-foreground" for="profileUrl">프로필 URL</label><input id="profileUrl" class="mt-2 w-full rounded-xl border border-border bg-background px-3 py-2" /></div>
          <div><label class="text-sm font-semibold text-muted-foreground" for="accentColor">포인트 색상</label><div class="mt-2 flex gap-2"><input id="accentColor" type="color" class="h-11 w-16 rounded-xl border border-border bg-background p-1" /><input id="accentColorText" class="w-full rounded-xl border border-border bg-background px-3 py-2" placeholder="#0f766e" /></div></div>
          <div><label class="text-sm font-semibold text-muted-foreground" for="postsPerPage">목록당 글 수</label><input id="postsPerPage" type="number" min="1" max="30" class="mt-2 w-full rounded-xl border border-border bg-background px-3 py-2" /></div>
        </div>
      </section>
    </section>
  </main>

  <div id="modal" class="fixed inset-0 z-50 hidden bg-black/65 p-4 backdrop-blur-sm">
    <article class="mx-auto flex h-full max-w-4xl flex-col overflow-hidden rounded-2xl border border-border bg-background shadow-2xl">
      <div class="flex items-center justify-between border-b border-border p-4"><h2 id="previewTitle" class="font-bold">미리보기</h2><button id="closeModalBtn" class="rounded-xl border border-border px-3 py-2 text-sm font-bold">닫기</button></div>
      <div id="preview" class="prose prose-neutral dark:prose-invert max-w-none overflow-auto p-6 leading-8"></div>
    </article>
  </div>

  <Footer />
</Layout>

<script>
  // @ts-nocheck
  const $ = id => document.getElementById(id);
  const state = { mode: "published", currentKind: null, currentPath: null, currentFilename: null, isTrash: false, items: [], visible: [], selected: new Set() };
  const fields = {
    lockPanel: $("lockPanel"), adminConsole: $("adminConsole"), apiBase: $("apiBase"), apiKey: $("apiKey"), lockStatus: $("lockStatus"), status: $("status"),
    list: $("articleList"), listTitle: $("listTitle"), search: $("searchInput"), selectAll: $("selectAll"), keyword: $("keyword"), tags: $("tags"), description: $("description"), currentPath: $("currentPath"), markdown: $("markdown"),
    statMode: $("statMode"), statCount: $("statCount"), statSelected: $("statSelected"), statChars: $("statChars"), contentPanel: $("contentPanel"), sitePanel: $("sitePanel"), modal: $("modal"), preview: $("preview"), previewTitle: $("previewTitle"),
    siteTitle: $("siteTitle"), siteAuthor: $("siteAuthor"), siteDescription: $("siteDescription"), siteUrl: $("siteUrl"), profileUrl: $("profileUrl"), accentColor: $("accentColor"), accentColorText: $("accentColorText"), postsPerPage: $("postsPerPage"),
  };

  fields.apiBase.value = localStorage.getItem("admin_api_base") || "http://127.0.0.1:8080";
  fields.apiKey.value = localStorage.getItem("blog_api_key") || "";
  updateStats();
  setEditorMode("published");

  function baseUrl() { return fields.apiBase.value.replace(/\/+$/, ""); }
  function encodePath(path) { return String(path || "").split("/").map(encodeURIComponent).join("/"); }
  function itemKey(item) { return state.mode === "published" ? item.path : item.filename; }
  function selectedItems() { return state.items.filter(item => state.selected.has(itemKey(item))); }
  function compactText(value) { return String(value || "").replace(/\s+/g, ""); }
  function titleFromFilename(filename) { return String(filename || "manual-article").replace(/\.mdx?$/i, "").replace(/^\d{8}-\d{6}-/, "").replace(/-/g, " ").trim() || "manual-article"; }
  function escapeHtml(value) { return String(value || "").replace(/[&<>"']/g, char => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[char])); }

  async function api(path, options = {}) {
    const response = await fetch(`${baseUrl()}${path}`, { ...options, headers: { "Content-Type": "application/json; charset=utf-8", "X-API-Key": fields.apiKey.value.trim(), ...(options.headers || {}) } });
    const text = await response.text();
    if (!response.ok) throw new Error(text || `${response.status} ${response.statusText}`);
    return text ? JSON.parse(text) : null;
  }
  async function safe(label, fn) {
    try { setStatus(`${label} 중...`); toggleButtons(true); const result = await fn(); setStatus(`${label} 완료`, "ok"); updateStats(); return result; }
    catch (error) { setStatus(error?.message || String(error), "bad"); }
    finally { toggleButtons(false); }
  }
  function toggleButtons(disabled) { document.querySelectorAll("button").forEach(button => { if (button.id !== "closeModalBtn") button.disabled = disabled; }); }
  function setStatus(message, type = "") {
    const target = fields.adminConsole.classList.contains("hidden") ? fields.lockStatus : fields.status;
    target.textContent = message;
    target.className = target.id === "status"
      ? `mt-4 min-h-6 rounded-xl border border-border bg-muted/35 px-4 py-3 text-sm ${type === "bad" ? "text-red-500" : type === "ok" ? "text-accent" : "text-muted-foreground"}`
      : `mt-4 min-h-6 text-sm ${type === "bad" ? "text-red-500" : type === "ok" ? "text-accent" : "text-muted-foreground"}`;
  }

  async function unlock() {
    localStorage.setItem("admin_api_base", fields.apiBase.value.trim()); localStorage.setItem("blog_api_key", fields.apiKey.value.trim());
    await api("/dashboard/status");
    fields.lockPanel.classList.add("hidden"); fields.adminConsole.classList.remove("hidden");
    setStatus("관리자 인증 완료", "ok"); await loadMode("published");
  }
  function lockAgain() { localStorage.removeItem("blog_api_key"); fields.apiKey.value = ""; fields.adminConsole.classList.add("hidden"); fields.lockPanel.classList.remove("hidden"); setStatus("잠금 상태입니다."); }
  async function loadMode(mode = state.mode) {
    state.mode = mode; state.selected.clear(); clearCurrent(false); setTabActive(mode); setEditorMode(mode);
    if (mode === "site") { fields.contentPanel.classList.add("hidden"); fields.sitePanel.classList.remove("hidden"); await loadSiteSettings(); updateBulkUi(); return; }
    fields.contentPanel.classList.remove("hidden"); fields.sitePanel.classList.add("hidden");
    if (mode === "published") return loadPublishedPosts();
    if (mode === "drafts") return loadDrafts(false);
    if (mode === "trash") return loadDrafts(true);
  }
  function setTabActive(mode) {
    document.querySelectorAll(".tabBtn").forEach(button => { const active = button.dataset.tab === mode; button.className = active ? "tabBtn rounded-xl bg-accent px-4 py-2 text-sm font-bold text-accent-foreground" : "tabBtn rounded-xl border border-border px-4 py-2 text-sm font-bold"; });
    const labels = { published: "발행글", drafts: "초안", trash: "복구함", site: "사이트 설정" };
    fields.statMode.textContent = labels[mode] || mode; fields.listTitle.textContent = labels[mode] || mode;
  }
  function setEditorMode(mode) {
    document.querySelectorAll(".actionPublished").forEach(el => el.classList.toggle("hidden", mode !== "published"));
    document.querySelectorAll(".actionDraft").forEach(el => el.classList.toggle("hidden", mode !== "drafts"));
    document.querySelectorAll(".actionTrash").forEach(el => el.classList.toggle("hidden", mode !== "trash"));
    $("newBtn").classList.toggle("hidden", mode !== "drafts");
  }
  function updateBulkUi() {
    const selected = state.selected.size;
    fields.statSelected.textContent = String(selected);
    fields.selectAll.checked = state.visible.length > 0 && state.visible.every(item => state.selected.has(itemKey(item)));
    fields.selectAll.indeterminate = selected > 0 && !fields.selectAll.checked;
    document.querySelectorAll(".bulkPublished").forEach(el => el.classList.toggle("hidden", state.mode !== "published"));
    document.querySelectorAll(".bulkDraft").forEach(el => el.classList.toggle("hidden", state.mode !== "drafts"));
    document.querySelectorAll(".bulkTrash").forEach(el => el.classList.toggle("hidden", state.mode !== "trash"));
  }

  async function loadPublishedPosts() { const data = await api("/github/posts?limit=300"); state.items = data.posts || []; renderList(); }
  async function loadDrafts(isTrash) { state.isTrash = isTrash; const data = await api(isTrash ? "/articles/trash?limit=300" : "/articles?limit=300"); state.items = data.articles || []; renderList(); }
  function searchableText(item) { return `${item.title || ""} ${item.filename || ""} ${item.path || ""} ${(item.tags || []).join(" ")}`.toLowerCase(); }
  function renderList() {
    const keyword = fields.search.value.trim().toLowerCase();
    state.visible = keyword ? state.items.filter(item => searchableText(item).includes(keyword)) : state.items;
    fields.statCount.textContent = String(state.visible.length);
    fields.list.replaceChildren();
    if (!state.visible.length) { const empty = document.createElement("p"); empty.className = "rounded-xl border border-dashed border-border p-4 text-sm text-muted-foreground"; empty.textContent = "표시할 항목이 없습니다."; fields.list.append(empty); updateBulkUi(); return; }
    state.visible.forEach(item => fields.list.append(listRow(item)));
    updateBulkUi();
  }
  function listRow(item) {
    const key = itemKey(item); const filename = item.filename || item.path || ""; const metaDate = item.pub_datetime || item.created_at || "";
    const badge = state.mode === "published" ? (item.draft ? "숨김" : "공개") : state.mode === "trash" ? "복구함" : "초안";
    const row = document.createElement("div"); row.className = "flex gap-3 rounded-xl border border-border bg-muted/35 p-3 transition hover:border-accent hover:bg-muted/60";
    row.innerHTML = `<input type="checkbox" class="mt-1 size-4 shrink-0 accent-current itemCheck" data-key="${escapeHtml(key)}" ${state.selected.has(key) ? "checked" : ""} /><button type="button" class="min-w-0 flex-1 text-left"><div class="flex items-start justify-between gap-2"><strong class="block min-w-0 truncate">${escapeHtml(item.title || filename)}</strong><span class="shrink-0 rounded-full bg-background px-2 py-1 text-[11px] font-bold text-muted-foreground">${badge}</span></div><span class="mt-1 block truncate text-xs text-muted-foreground">${escapeHtml(filename)}</span><small class="mt-2 block text-muted-foreground">${escapeHtml(metaDate)} · ${Number(item.compact_chars || 0).toLocaleString("ko-KR")}자</small></button>`;
    row.querySelector("button").addEventListener("click", () => state.mode === "published" ? loadPublishedDetail(item.path) : loadDraftDetail(item.filename, state.mode === "trash"));
    row.querySelector(".itemCheck").addEventListener("change", event => { event.target.checked ? state.selected.add(key) : state.selected.delete(key); updateBulkUi(); });
    return row;
  }

  async function loadPublishedDetail(path) { const post = await api(`/github/posts/${encodePath(path)}`); state.currentKind = "published"; state.currentPath = post.path; state.currentFilename = null; fillEditor({ title: post.title, description: post.description, tags: post.tags, path: post.path, markdown: post.markdown }); setStatus(`발행글 불러오기: ${post.title}`, "ok"); }
  async function loadDraftDetail(filename, isTrash) { const article = await api(isTrash ? `/articles/trash/${encodeURIComponent(filename)}` : `/articles/${encodeURIComponent(filename)}`); state.currentKind = isTrash ? "trash" : "draft"; state.currentFilename = article.filename; state.currentPath = null; fillEditor({ title: article.title, description: extractFrontmatterValue(article.markdown, "description"), tags: extractFrontmatterTags(article.markdown), path: article.filename, markdown: article.markdown }); setStatus(`${isTrash ? "복구함" : "초안"} 불러오기: ${article.title}`, "ok"); }
  function fillEditor({ title, description, tags, path, markdown }) { fields.keyword.value = title || ""; fields.description.value = description || ""; fields.tags.value = (tags || []).join(", "); fields.currentPath.value = path || ""; fields.markdown.value = markdown || ""; updateStats(); }
  function clearCurrent(clearMarkdown = true) { state.currentKind = null; state.currentPath = null; state.currentFilename = null; fields.keyword.value = ""; fields.tags.value = ""; fields.description.value = ""; fields.currentPath.value = ""; if (clearMarkdown) fields.markdown.value = ""; updateStats(); }

  async function bulkPublishedDraft(draft) { const items = selectedItems(); if (!items.length) throw new Error("선택된 글이 없습니다."); for (let index = 0; index < items.length; index += 1) { setStatus(`${index + 1}/${items.length} 처리 중...`); await api("/github/posts/draft", { method: "POST", body: JSON.stringify({ path: items[index].path, draft }) }); } state.selected.clear(); await loadPublishedPosts(); }
  async function bulkDeletePublished() { const items = selectedItems(); if (!items.length) throw new Error("선택된 글이 없습니다."); if (!confirm(`선택한 발행글 ${items.length}개를 GitHub에서 삭제할까요?`)) return; for (let index = 0; index < items.length; index += 1) { setStatus(`${index + 1}/${items.length} 삭제 중...`); await api(`/github/posts/${encodePath(items[index].path)}`, { method: "DELETE" }); } state.selected.clear(); clearCurrent(); await loadPublishedPosts(); }
  async function bulkPublishDrafts() {
    const items = selectedItems();
    if (!items.length) throw new Error("선택된 초안이 없습니다.");
    if (!confirm(`선택한 초안 ${items.length}개를 품질 검사 후 GitHub에 발행할까요?`)) return;
    let published = 0;
    const failures = [];
    for (let index = 0; index < items.length; index += 1) {
      const item = items[index];
      setStatus(`${index + 1}/${items.length} 발행 중: ${item.title || item.filename}`);
      try {
        const article = await api(`/articles/${encodeURIComponent(item.filename)}`);
        const markdown = article.markdown || "";
        const tags = extractFrontmatterTags(markdown);
        const description = extractFrontmatterValue(markdown, "description") || article.preview || null;
        await api("/publish/github", {
          method: "POST",
          body: JSON.stringify({
            keyword: article.title || titleFromFilename(item.filename),
            markdown,
            github_tags: tags,
            github_description: description,
          }),
        });
        published += 1;
      } catch (error) {
        failures.push(`${item.filename}: ${error?.message || String(error)}`);
      }
    }
    state.selected.clear();
    await loadDrafts(false);
    if (failures.length) throw new Error(`${published}개 발행, ${failures.length}개 실패. 첫 실패: ${failures[0]}`);
    setStatus(`${published}개 초안 발행 완료`, "ok");
  }
  async function bulkDeleteDrafts() { const items = selectedItems(); if (!items.length) throw new Error("선택된 초안이 없습니다."); if (!confirm(`선택한 초안 ${items.length}개를 복구함으로 이동할까요?`)) return; for (let index = 0; index < items.length; index += 1) { setStatus(`${index + 1}/${items.length} 삭제 중...`); await api(`/articles/${encodeURIComponent(items[index].filename)}`, { method: "DELETE" }); } state.selected.clear(); clearCurrent(); await loadDrafts(false); }
  async function bulkRestoreDrafts() { const items = selectedItems(); if (!items.length) throw new Error("선택된 복구 항목이 없습니다."); for (let index = 0; index < items.length; index += 1) { setStatus(`${index + 1}/${items.length} 복구 중...`); await api(`/articles/trash/${encodeURIComponent(items[index].filename)}/restore`, { method: "POST" }); } state.selected.clear(); clearCurrent(); await loadDrafts(true); }

  async function savePublished() { if (!state.currentPath) throw new Error("수정할 발행글을 선택하세요."); return api(`/github/posts/${encodePath(state.currentPath)}`, { method: "PUT", body: JSON.stringify({ markdown: fields.markdown.value }) }); }
  async function setPublishedDraft(draft) { if (!state.currentPath) throw new Error("상태를 바꿀 발행글을 선택하세요."); return api("/github/posts/draft", { method: "POST", body: JSON.stringify({ path: state.currentPath, draft }) }); }
  async function deletePublished() { if (!state.currentPath) throw new Error("삭제할 발행글을 선택하세요."); if (!confirm("GitHub에서 이 글 파일을 삭제합니다. 계속할까요?")) return; const result = await api(`/github/posts/${encodePath(state.currentPath)}`, { method: "DELETE" }); clearCurrent(); await loadPublishedPosts(); return result; }
  async function saveDraft(updateExisting) { const markdown = fields.markdown.value.trim(); const keyword = fields.keyword.value.trim() || "manual-article"; if (!markdown) throw new Error("저장할 Markdown이 없습니다."); if (updateExisting && state.currentFilename && state.currentKind === "draft") { const data = await api(`/articles/${encodeURIComponent(state.currentFilename)}`, { method: "PUT", body: JSON.stringify({ markdown }) }); state.currentFilename = data.filename; await loadDrafts(false); return data; } const data = await api("/articles", { method: "POST", body: JSON.stringify({ keyword, markdown }) }); state.currentKind = "draft"; state.currentFilename = data.filename; await loadDrafts(false); return data; }
  async function deleteDraft() { if (!state.currentFilename || state.currentKind !== "draft") throw new Error("삭제할 초안을 선택하세요."); if (!confirm("선택한 초안을 복구함으로 이동할까요?")) return; const data = await api(`/articles/${encodeURIComponent(state.currentFilename)}`, { method: "DELETE" }); clearCurrent(); await loadDrafts(false); return data; }
  async function restoreDraft() { if (!state.currentFilename || state.currentKind !== "trash") throw new Error("복구함에서 글을 선택하세요."); const data = await api(`/articles/trash/${encodeURIComponent(state.currentFilename)}/restore`, { method: "POST" }); clearCurrent(); await loadDrafts(true); return data; }
  async function publishCurrent() { const markdown = fields.markdown.value.trim(); const keyword = fields.keyword.value.trim() || "manual-article"; if (!markdown) throw new Error("발행할 Markdown이 없습니다."); const tags = fields.tags.value.split(",").map(x => x.trim()).filter(Boolean); return api("/publish/github", { method: "POST", body: JSON.stringify({ keyword, markdown, github_tags: tags, github_description: fields.description.value.trim() || null }) }); }

  async function loadSiteSettings() { const data = await api("/github/site-ui"); const settings = data.settings || {}; fields.siteTitle.value = settings.site_title || ""; fields.siteAuthor.value = settings.site_author || ""; fields.siteDescription.value = settings.site_description || ""; fields.siteUrl.value = settings.site_url || ""; fields.profileUrl.value = settings.profile_url || ""; fields.accentColor.value = settings.accent_color || "#0f766e"; fields.accentColorText.value = settings.accent_color || "#0f766e"; fields.postsPerPage.value = settings.posts_per_page || 6; setStatus("사이트 설정을 불러왔습니다.", "ok"); }
  async function saveSiteSettings() { const color = fields.accentColorText.value.trim() || fields.accentColor.value; if (!/^#[0-9a-fA-F]{6}$/.test(color)) throw new Error("포인트 색상은 #0f766e 형식이어야 합니다."); return api("/github/site-ui", { method: "PUT", body: JSON.stringify({ site_title: fields.siteTitle.value.trim() || null, site_author: fields.siteAuthor.value.trim() || null, site_description: fields.siteDescription.value.trim() || null, site_url: fields.siteUrl.value.trim() || null, profile_url: fields.profileUrl.value.trim() || null, accent_color: color, posts_per_page: Number(fields.postsPerPage.value || 6) }) }); }
  function newDraft() { loadMode("drafts"); clearCurrent(); state.currentKind = "draft"; setStatus("새 초안을 작성할 수 있습니다.", "ok"); }
  function updateStats() { fields.statSelected.textContent = String(state.selected.size); fields.statChars.textContent = compactText(fields.markdown.value).length.toLocaleString("ko-KR"); }
  function extractFrontmatterValue(markdown, key) { const match = String(markdown || "").match(new RegExp(`^---[\\s\\S]*?^${key}:\\s*[\"']?([^\\n\"']+)`, "m")); return match ? match[1].trim() : ""; }
  function extractFrontmatterTags(markdown) { const text = String(markdown || ""); const inline = text.match(/^---[\s\S]*?^tags:\s*\[([^\]]*)\]/m); if (inline) return inline[1].split(",").map(tag => tag.replace(/["']/g, "").trim()).filter(Boolean); const block = text.match(/^---[\s\S]*?^tags:\s*\n((?:\s+-\s+.*\n?)+)/m); if (!block) return []; return block[1].split("\n").map(line => line.replace(/^\s+-\s+/, "").replace(/["']/g, "").trim()).filter(Boolean); }
  function markdownToHtml(markdown) { return String(markdown || "").replace(/^---[\s\S]*?---\s*/, "").split(/\n{2,}/).map(block => { const text = block.trim(); if (!text) return ""; if (text.startsWith("## ")) return `<h2>${escapeHtml(text.slice(3))}</h2>`; if (text.startsWith("### ")) return `<h3>${escapeHtml(text.slice(4))}</h3>`; if (text.startsWith("# ")) return `<h1>${escapeHtml(text.slice(2))}</h1>`; if (text.startsWith("- ")) return `<ul>${text.split("\n").map(line => `<li>${escapeHtml(line.replace(/^-\s*/, ""))}</li>`).join("")}</ul>`; return `<p>${escapeHtml(text)}</p>`; }).join("\n"); }
  function openPreview() { fields.previewTitle.textContent = fields.keyword.value || "미리보기"; fields.preview.innerHTML = markdownToHtml(fields.markdown.value); fields.modal.classList.remove("hidden"); }

  $("unlockBtn").addEventListener("click", () => safe("관리자 인증", unlock));
  $("lockAgainBtn").addEventListener("click", lockAgain);
  $("refreshBtn").addEventListener("click", () => safe("새로고침", () => loadMode(state.mode)));
  document.querySelectorAll(".tabBtn").forEach(button => button.addEventListener("click", () => safe(button.textContent.trim(), () => loadMode(button.dataset.tab))));
  fields.search.addEventListener("input", renderList);
  $("searchBtn").addEventListener("click", renderList);
  fields.selectAll.addEventListener("change", () => { state.visible.forEach(item => fields.selectAll.checked ? state.selected.add(itemKey(item)) : state.selected.delete(itemKey(item))); renderList(); });
  $("bulkHideBtn").addEventListener("click", () => safe("선택 숨김", () => bulkPublishedDraft(true)));
  $("bulkShowBtn").addEventListener("click", () => safe("선택 공개", () => bulkPublishedDraft(false)));
  $("bulkDeletePublishedBtn").addEventListener("click", () => safe("선택 발행글 삭제", bulkDeletePublished));
  $("bulkPublishDraftBtn").addEventListener("click", () => safe("선택 초안 발행", bulkPublishDrafts));
  $("bulkDeleteDraftBtn").addEventListener("click", () => safe("선택 초안 삭제", bulkDeleteDrafts));
  $("bulkRestoreBtn").addEventListener("click", () => safe("선택 복구", bulkRestoreDrafts));
  $("newBtn").addEventListener("click", newDraft);
  $("savePublishedBtn").addEventListener("click", () => safe("발행글 수정 저장", async () => { const result = await savePublished(); await loadPublishedPosts(); return result; }));
  $("hidePublishedBtn").addEventListener("click", () => safe("공개 숨김", async () => { const result = await setPublishedDraft(true); await loadPublishedPosts(); return result; }));
  $("showPublishedBtn").addEventListener("click", () => safe("다시 공개", async () => { const result = await setPublishedDraft(false); await loadPublishedPosts(); return result; }));
  $("deletePublishedBtn").addEventListener("click", () => safe("발행글 삭제", deletePublished));
  $("saveDraftBtn").addEventListener("click", () => safe("초안 수정 저장", () => saveDraft(true)));
  $("createDraftBtn").addEventListener("click", () => safe("새 초안 저장", () => saveDraft(false)));
  $("deleteDraftBtn").addEventListener("click", () => safe("초안 삭제", deleteDraft));
  $("restoreDraftBtn").addEventListener("click", () => safe("복구", restoreDraft));
  $("publishBtn").addEventListener("click", () => safe("승인 발행", publishCurrent));
  $("previewBtn").addEventListener("click", openPreview);
  $("closeModalBtn").addEventListener("click", () => fields.modal.classList.add("hidden"));
  $("loadSiteBtn").addEventListener("click", () => safe("사이트 설정 불러오기", loadSiteSettings));
  $("saveSiteBtn").addEventListener("click", () => safe("사이트 설정 저장", saveSiteSettings));
  fields.accentColor.addEventListener("input", () => fields.accentColorText.value = fields.accentColor.value);
  fields.accentColorText.addEventListener("input", () => { if (/^#[0-9a-fA-F]{6}$/.test(fields.accentColorText.value)) fields.accentColor.value = fields.accentColorText.value; });
  fields.markdown.addEventListener("input", updateStats);
  if (fields.apiKey.value) safe("관리자 인증", unlock);
</script>
