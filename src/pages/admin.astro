---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";
---

<Layout title={`관리 | ${config.site.title}`} description="저장된 원고를 수정, 삭제, 복구하고 승인 발행하는 관리자 페이지입니다.">
  <Fragment slot="head">
    <meta name="robots" content="noindex,nofollow" />
  </Fragment>

  <Header />
  <main id="main-content" class="mx-auto w-full max-w-7xl px-4 py-8">
    <section class="grid gap-4 lg:grid-cols-[1.1fr_0.9fr]">
      <div class="rounded-2xl border border-border bg-background p-5 shadow-sm sm:p-7">
        <p class="text-accent text-xs font-bold tracking-[0.2em] uppercase">Admin Console</p>
        <h1 class="mt-3 text-3xl font-bold tracking-tight sm:text-5xl">글 관리</h1>
        <p class="text-muted-foreground mt-4 max-w-2xl leading-8">
          저장된 초안과 삭제된 글을 한 화면에서 관리합니다. 공개 블로그에는 관리 버튼을 노출하지 않고, 이 페이지에서만 수정, 삭제, 복구, 승인 발행을 처리합니다.
        </p>
      </div>
      <div class="grid gap-3 rounded-2xl border border-border bg-muted/35 p-4 sm:grid-cols-3">
        <div class="rounded-xl bg-background p-4">
          <p class="text-muted-foreground text-sm font-semibold">상태</p>
          <p id="statMode" class="mt-2 text-2xl font-bold">대기</p>
        </div>
        <div class="rounded-xl bg-background p-4">
          <p class="text-muted-foreground text-sm font-semibold">선택 글</p>
          <p id="statFile" class="mt-2 truncate text-lg font-bold">없음</p>
        </div>
        <div class="rounded-xl bg-background p-4">
          <p class="text-muted-foreground text-sm font-semibold">글자 수</p>
          <p id="statChars" class="mt-2 text-2xl font-bold">0</p>
        </div>
      </div>
    </section>

    <section class="mt-6 grid gap-5 lg:grid-cols-[360px_1fr]">
      <aside class="space-y-5">
        <div class="rounded-2xl border border-border bg-background p-4 shadow-sm">
          <div class="flex items-center justify-between gap-3">
            <h2 class="text-lg font-bold">연결</h2>
            <span id="connectionBadge" class="rounded-full bg-muted px-3 py-1 text-xs font-bold text-muted-foreground">미저장</span>
          </div>
          <label class="mt-4 block text-sm font-semibold text-muted-foreground" for="apiBase">Backend URL</label>
          <input id="apiBase" class="mt-2 w-full rounded-xl border border-border bg-background px-3 py-2" value="http://127.0.0.1:8080" />
          <label class="mt-4 block text-sm font-semibold text-muted-foreground" for="apiKey">BLOG_API_KEY</label>
          <input id="apiKey" type="password" class="mt-2 w-full rounded-xl border border-border bg-background px-3 py-2" placeholder="API Key" />
          <div class="mt-4 grid grid-cols-3 gap-2">
            <button id="saveConnectionBtn" class="rounded-xl bg-accent px-3 py-2 text-sm font-bold text-accent-foreground">저장</button>
            <button id="loadBtn" class="rounded-xl border border-border px-3 py-2 text-sm font-bold">초안</button>
            <button id="trashBtn" class="rounded-xl border border-border px-3 py-2 text-sm font-bold">복구함</button>
          </div>
          <p id="status" class="mt-3 min-h-6 text-sm text-muted-foreground"></p>
        </div>

        <div class="rounded-2xl border border-border bg-background p-4 shadow-sm">
          <div class="flex items-center justify-between gap-3">
            <h2 class="text-lg font-bold">목록</h2>
            <button id="newBtn" class="rounded-xl border border-border px-3 py-2 text-sm font-bold">새 글</button>
          </div>
          <div class="mt-3 flex gap-2">
            <input id="searchInput" class="w-full rounded-xl border border-border bg-background px-3 py-2 text-sm" placeholder="제목 검색" />
            <button id="searchBtn" class="rounded-xl border border-border px-3 py-2 text-sm font-bold">검색</button>
          </div>
          <div id="articleList" class="mt-4 max-h-[620px] space-y-2 overflow-auto pr-1"></div>
        </div>
      </aside>

      <section class="rounded-2xl border border-border bg-background p-4 shadow-sm sm:p-5">
        <div class="grid gap-3 sm:grid-cols-[1fr_1fr]">
          <div>
            <label class="block text-sm font-semibold text-muted-foreground" for="keyword">키워드 / 제목</label>
            <input id="keyword" class="mt-2 w-full rounded-xl border border-border bg-background px-3 py-2" placeholder="글 제목 또는 키워드" />
          </div>
          <div>
            <label class="block text-sm font-semibold text-muted-foreground" for="tags">태그</label>
            <input id="tags" class="mt-2 w-full rounded-xl border border-border bg-background px-3 py-2" placeholder="쉼표로 구분" />
          </div>
        </div>
        <label class="mt-4 block text-sm font-semibold text-muted-foreground" for="description">Description</label>
        <input id="description" class="mt-2 w-full rounded-xl border border-border bg-background px-3 py-2" placeholder="검색 결과에 보일 설명" />

        <div class="mt-4 flex flex-wrap gap-2">
          <button id="saveBtn" class="rounded-xl bg-accent px-3 py-2 text-sm font-bold text-accent-foreground">수정 저장</button>
          <button id="createBtn" class="rounded-xl border border-border px-3 py-2 text-sm font-bold">새 파일 저장</button>
          <button id="previewBtn" class="rounded-xl border border-border px-3 py-2 text-sm font-bold">미리보기</button>
          <button id="publishBtn" class="rounded-xl border border-border px-3 py-2 text-sm font-bold">승인 발행</button>
          <button id="restoreBtn" class="rounded-xl border border-amber-400 px-3 py-2 text-sm font-bold text-amber-600">복구</button>
          <button id="deleteBtn" class="rounded-xl border border-red-400 px-3 py-2 text-sm font-bold text-red-500">삭제</button>
        </div>

        <textarea id="markdown" class="mt-4 min-h-[640px] w-full rounded-xl border border-border bg-background px-4 py-3 font-mono text-sm leading-7" spellcheck="false" placeholder="저장글을 선택하거나 새 원고를 작성하세요."></textarea>
      </section>
    </section>
  </main>

  <div id="modal" class="fixed inset-0 z-50 hidden bg-black/65 p-4 backdrop-blur-sm">
    <article class="mx-auto flex h-full max-w-4xl flex-col overflow-hidden rounded-2xl border border-border bg-background shadow-2xl">
      <div class="flex items-center justify-between border-b border-border p-4">
        <h2 id="previewTitle" class="font-bold">미리보기</h2>
        <button id="closeModalBtn" class="rounded-xl border border-border px-3 py-2 text-sm font-bold">닫기</button>
      </div>
      <div id="preview" class="prose prose-neutral dark:prose-invert max-w-none overflow-auto p-6 leading-8"></div>
    </article>
  </div>

  <Footer />
</Layout>

<script>
  // @ts-nocheck
  const $ = id => document.getElementById(id);
  const state = { filename: null, isTrash: false, articles: [] };

  const fields = {
    apiBase: $("apiBase"),
    apiKey: $("apiKey"),
    keyword: $("keyword"),
    tags: $("tags"),
    description: $("description"),
    markdown: $("markdown"),
    status: $("status"),
    list: $("articleList"),
    modal: $("modal"),
    preview: $("preview"),
    previewTitle: $("previewTitle"),
    search: $("searchInput"),
    statMode: $("statMode"),
    statFile: $("statFile"),
    statChars: $("statChars"),
    badge: $("connectionBadge"),
  };

  fields.apiBase.value = localStorage.getItem("admin_api_base") || "http://127.0.0.1:8080";
  fields.apiKey.value = localStorage.getItem("blog_api_key") || "";
  updateConnectionBadge();
  updateStats();

  function setStatus(message, type = "") {
    fields.status.textContent = message;
    fields.status.className = `mt-3 min-h-6 text-sm ${type === "bad" ? "text-red-500" : type === "ok" ? "text-accent" : "text-muted-foreground"}`;
    fields.statMode.textContent = type === "bad" ? "확인 필요" : type === "ok" ? "완료" : "진행";
  }

  function updateConnectionBadge() {
    const ready = fields.apiBase.value.trim() && fields.apiKey.value.trim();
    fields.badge.textContent = ready ? "저장됨" : "미저장";
    fields.badge.className = ready
      ? "rounded-full bg-accent px-3 py-1 text-xs font-bold text-accent-foreground"
      : "rounded-full bg-muted px-3 py-1 text-xs font-bold text-muted-foreground";
  }

  function updateStats() {
    fields.statFile.textContent = state.filename || "없음";
    fields.statChars.textContent = compactText(fields.markdown.value).length.toLocaleString("ko-KR");
  }

  function baseUrl() {
    return fields.apiBase.value.replace(/\/+$/, "");
  }

  async function api(path, options = {}) {
    const response = await fetch(`${baseUrl()}${path}`, {
      ...options,
      headers: {
        "Content-Type": "application/json; charset=utf-8",
        "X-API-Key": fields.apiKey.value.trim(),
        ...(options.headers || {}),
      },
    });
    const text = await response.text();
    if (!response.ok) throw new Error(text || `${response.status} ${response.statusText}`);
    return text ? JSON.parse(text) : null;
  }

  async function safe(label, fn) {
    try {
      setStatus(`${label} 중...`);
      toggleButtons(true);
      const result = await fn();
      setStatus(`${label} 완료`, "ok");
      updateStats();
      return result;
    } catch (error) {
      setStatus(error?.message || String(error), "bad");
    } finally {
      toggleButtons(false);
    }
  }

  function toggleButtons(disabled) {
    document.querySelectorAll("button").forEach(button => {
      if (button.id !== "closeModalBtn") button.disabled = disabled;
    });
  }

  function compactText(value) {
    return String(value || "").replace(/\s+/g, "");
  }

  function escapeHtml(value) {
    return String(value || "").replace(/[&<>"']/g, char => ({
      "&": "&amp;",
      "<": "&lt;",
      ">": "&gt;",
      '"': "&quot;",
      "'": "&#39;",
    }[char]));
  }

  function renderArticleList(articles = state.articles) {
    const keyword = fields.search.value.trim().toLowerCase();
    const visible = keyword
      ? articles.filter(article => `${article.title} ${article.filename}`.toLowerCase().includes(keyword))
      : articles;
    fields.list.replaceChildren();
    if (!visible.length) {
      const empty = document.createElement("p");
      empty.className = "rounded-xl border border-dashed border-border p-4 text-sm text-muted-foreground";
      empty.textContent = state.isTrash ? "복구함이 비어 있습니다." : "저장된 글이 없습니다.";
      fields.list.append(empty);
      return;
    }
    visible.forEach(article => fields.list.append(articleButton(article, state.isTrash)));
  }

  function articleButton(article, isTrash) {
    const button = document.createElement("button");
    button.type = "button";
    button.className = "w-full rounded-xl border border-border bg-muted/35 p-3 text-left transition hover:border-accent hover:bg-muted/60";
    button.innerHTML = `<strong class="block truncate">${escapeHtml(article.title)}</strong><span class="mt-1 block truncate text-xs text-muted-foreground">${escapeHtml(article.filename)}</span><small class="mt-2 block text-muted-foreground">${escapeHtml(article.created_at)} · ${Number(article.compact_chars || 0).toLocaleString("ko-KR")}자</small>`;
    button.addEventListener("click", () => loadDetail(article.filename, isTrash));
    return button;
  }

  async function loadList(isTrash = false) {
    state.isTrash = isTrash;
    fields.statMode.textContent = isTrash ? "복구함" : "초안";
    const data = await api(isTrash ? "/articles/trash?limit=300" : "/articles?limit=300");
    state.articles = data.articles || [];
    renderArticleList();
  }

  async function loadDetail(filename, isTrash = state.isTrash) {
    const article = await api(isTrash ? `/articles/trash/${encodeURIComponent(filename)}` : `/articles/${encodeURIComponent(filename)}`);
    state.filename = article.filename;
    state.isTrash = isTrash;
    fields.keyword.value = article.title || "";
    fields.description.value = extractFrontmatterValue(article.markdown, "description");
    fields.tags.value = extractFrontmatterTags(article.markdown).join(", ");
    fields.markdown.value = article.markdown || "";
    setStatus(`${isTrash ? "복구함" : "저장글"} 불러오기: ${article.title}`, "ok");
    updateStats();
  }

  function extractFrontmatterValue(markdown, key) {
    const match = String(markdown || "").match(new RegExp(`^---[\\s\\S]*?^${key}:\\s*[\"']?([^\\n\"']+)`, "m"));
    return match ? match[1].trim() : "";
  }

  function extractFrontmatterTags(markdown) {
    const match = String(markdown || "").match(/^---[\s\S]*?^tags:\s*\[([^\]]*)\]/m);
    if (!match) return [];
    return match[1].split(",").map(tag => tag.replace(/["']/g, "").trim()).filter(Boolean);
  }

  async function saveCurrent(updateExisting) {
    const markdown = fields.markdown.value.trim();
    const keyword = fields.keyword.value.trim() || "manual-article";
    if (!markdown) throw new Error("저장할 Markdown이 없습니다.");
    if (updateExisting && state.filename && !state.isTrash) {
      const data = await api(`/articles/${encodeURIComponent(state.filename)}`, {
        method: "PUT",
        body: JSON.stringify({ markdown }),
      });
      state.filename = data.filename;
      await loadList(false);
      return data;
    }
    const data = await api("/articles", {
      method: "POST",
      body: JSON.stringify({ keyword, markdown }),
    });
    state.filename = data.filename;
    state.isTrash = false;
    await loadList(false);
    return data;
  }

  async function deleteCurrent() {
    if (!state.filename || state.isTrash) throw new Error("삭제할 저장글을 선택하세요.");
    if (!confirm("선택한 글을 복구함으로 이동할까요?")) return;
    const data = await api(`/articles/${encodeURIComponent(state.filename)}`, { method: "DELETE" });
    state.filename = null;
    fields.markdown.value = "";
    await loadList(false);
    return data;
  }

  async function restoreCurrent() {
    if (!state.filename || !state.isTrash) throw new Error("복구함에서 복구할 글을 선택하세요.");
    const data = await api(`/articles/trash/${encodeURIComponent(state.filename)}/restore`, { method: "POST" });
    state.filename = data.filename;
    state.isTrash = false;
    await loadList(false);
    return data;
  }

  async function publishCurrent() {
    const markdown = fields.markdown.value.trim();
    const keyword = fields.keyword.value.trim() || "manual-article";
    if (!markdown) throw new Error("발행할 Markdown이 없습니다.");
    const tags = fields.tags.value.split(",").map(x => x.trim()).filter(Boolean);
    return api("/publish/github", {
      method: "POST",
      body: JSON.stringify({
        keyword,
        markdown,
        github_tags: tags,
        github_description: fields.description.value.trim() || null,
      }),
    });
  }

  function newDraft() {
    state.filename = null;
    state.isTrash = false;
    fields.keyword.value = "";
    fields.tags.value = "";
    fields.description.value = "";
    fields.markdown.value = "";
    setStatus("새 글을 작성할 수 있습니다.", "ok");
    updateStats();
  }

  function markdownToHtml(markdown) {
    return String(markdown || "")
      .replace(/^---[\s\S]*?---\s*/, "")
      .split(/\n{2,}/)
      .map(block => {
        const text = block.trim();
        if (!text) return "";
        if (text.startsWith("## ")) return `<h2>${escapeHtml(text.slice(3))}</h2>`;
        if (text.startsWith("### ")) return `<h3>${escapeHtml(text.slice(4))}</h3>`;
        if (text.startsWith("# ")) return `<h1>${escapeHtml(text.slice(2))}</h1>`;
        if (text.startsWith("- ")) return `<ul>${text.split("\n").map(line => `<li>${escapeHtml(line.replace(/^-\s*/, ""))}</li>`).join("")}</ul>`;
        return `<p>${escapeHtml(text)}</p>`;
      })
      .join("\n");
  }

  function openPreview() {
    fields.previewTitle.textContent = fields.keyword.value || "미리보기";
    fields.preview.innerHTML = markdownToHtml(fields.markdown.value);
    fields.modal.classList.remove("hidden");
  }

  fields.markdown.addEventListener("input", updateStats);
  fields.search.addEventListener("input", () => renderArticleList());
  $("searchBtn").addEventListener("click", () => renderArticleList());
  $("saveConnectionBtn").addEventListener("click", () => {
    localStorage.setItem("admin_api_base", fields.apiBase.value.trim());
    localStorage.setItem("blog_api_key", fields.apiKey.value.trim());
    updateConnectionBadge();
    setStatus("연결 정보를 저장했습니다.", "ok");
  });
  $("loadBtn").addEventListener("click", () => safe("초안 목록", () => loadList(false)));
  $("trashBtn").addEventListener("click", () => safe("복구함", () => loadList(true)));
  $("newBtn").addEventListener("click", newDraft);
  $("saveBtn").addEventListener("click", () => safe("수정 저장", () => saveCurrent(true)));
  $("createBtn").addEventListener("click", () => safe("새 파일 저장", () => saveCurrent(false)));
  $("deleteBtn").addEventListener("click", () => safe("삭제", deleteCurrent));
  $("restoreBtn").addEventListener("click", () => safe("복구", restoreCurrent));
  $("publishBtn").addEventListener("click", () => safe("승인 발행", publishCurrent));
  $("previewBtn").addEventListener("click", openPreview);
  $("closeModalBtn").addEventListener("click", () => fields.modal.classList.add("hidden"));

  if (fields.apiKey.value) safe("초안 목록", () => loadList(false));
</script>
