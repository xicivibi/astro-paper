---
import { getCollection } from "astro:content";
import type { GetStaticPaths } from "astro";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import ListCard from "@/components/ListCard.astro";
import { topics } from "@/config/topics";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { getTopicPosts } from "@/utils/topicPosts";
import config from "@/config";

export const getStaticPaths = (async () => {
  const posts = await getCollection("posts", ({ data }) => !data.draft);
  const sortedPosts = getSortedPosts(posts);

  return topics.map(topic => ({
    params: { slug: topic.slug },
    props: { topic, posts: getTopicPosts(sortedPosts, topic) },
  }));
}) satisfies GetStaticPaths;

const { topic, posts } = Astro.props;
const verifiedPosts = posts.filter(
  post =>
    post.data.testingStatus !== "not_tested" || post.data.sources.length > 0
);
const unverifiedPosts = posts.filter(post => !verifiedPosts.includes(post));
---

<Layout
  title={`${topic.title} | ${config.site.title}`}
  description={topic.intro}
>
  <Header />
  <Main pageTitle={topic.title} pageDesc={topic.intro}>
    <nav class="mb-6 flex flex-wrap gap-3 text-sm" aria-label="주제 허브 이동">
      <a href="/topics/" class="text-accent">모든 주제</a>
      <a href="/posts/" class="text-accent">전체 글</a>
      <a href="/tools/" class="text-accent">업무 도구</a>
      {
        topic.slug === "excel-csv" && (
          <a href="/tools/csv-preview/" class="text-accent">
            CSV 파일 점검 도구
          </a>
        )
      }
    </nav>

    {
      posts.length > 0 ? (
        <>
          <p class="text-muted-foreground mb-4 text-sm">
            분류된 글 {posts.length}개 · 검증 메타데이터 제공{" "}
            {verifiedPosts.length}개
          </p>
          {verifiedPosts.length > 0 && (
            <section aria-labelledby="verified-topic-posts">
              <h2 id="verified-topic-posts" class="text-lg font-bold">
                확인 정보가 있는 글
              </h2>
              <ul class="mt-3">
                {verifiedPosts.map(post => (
                  <ListCard {...post} />
                ))}
              </ul>
            </section>
          )}
          {unverifiedPosts.length > 0 && (
            <section
              aria-labelledby="unverified-topic-posts"
              class="border-border mt-8 border-t pt-6"
            >
              <h2 id="unverified-topic-posts" class="text-lg font-bold">
                검증 정보 미제공 글
              </h2>
              <p class="text-muted-foreground mt-1 text-sm">
                출처·검토일·테스트 상태가 입력되지 않은 글입니다.
              </p>
              <ul class="mt-3">
                {unverifiedPosts.map(post => (
                  <ListCard {...post} />
                ))}
              </ul>
            </section>
          )}
        </>
      ) : (
        <div class="border-border bg-muted/35 rounded border p-5">
          <h2 class="font-bold">아직 공개 글이 없습니다</h2>
          <p class="text-muted-foreground mt-2 text-sm leading-6">
            {topic.emptyState}
          </p>
          <p class="text-muted-foreground mt-2 text-sm leading-6">
            새 글이 이 주제의 명시적 태그를 가질 때 자동으로 이 목록에
            추가됩니다.
          </p>
          <div class="mt-4 flex flex-wrap gap-3 text-sm">
            <a href="/posts/" class="text-accent font-semibold">
              최신 글 보기
            </a>
            <a href="/search/" class="text-accent font-semibold">
              전체 검색
            </a>
          </div>
        </div>
      )
    }
  </Main>
  <Footer />
</Layout>
