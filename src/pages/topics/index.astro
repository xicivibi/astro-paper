---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import { topics } from "@/config/topics";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { getActiveTopicSummaries } from "@/utils/topicPosts";
import config from "@/config";

const posts = await getCollection("posts", ({ data }) => !data.draft);
const activeTopics = getActiveTopicSummaries(getSortedPosts(posts), topics);
---

<Layout
  title={`주제 허브 | ${config.site.title}`}
  description="실무 주제별 공개 글 모음입니다."
>
  <Header />
  <Main
    pageTitle="주제 허브"
    pageDesc="현재 공개된 실무 가이드를 문제 영역별로 모았습니다."
  >
    <ul class="grid gap-4 sm:grid-cols-3">
      {
        activeTopics.map(({ topic, count }) => (
          <li class="border-border rounded border p-4">
            <h2 class="text-lg font-bold">
              <a
                href={`/topics/${topic.slug}/`}
                class="hover:text-accent no-underline"
              >
                {topic.title}
              </a>
            </h2>
            <p class="text-muted-foreground mt-2 text-sm leading-6">
              {topic.intro}
            </p>
            <p class="text-muted-foreground mt-3 text-xs">공개 글 {count}개</p>
            <a
              href={`/topics/${topic.slug}/`}
              class="text-accent mt-4 inline-block text-sm font-semibold"
            >
              허브 열기 →
            </a>
          </li>
        ))
      }
    </ul>
  </Main>
  <Footer />
</Layout>
