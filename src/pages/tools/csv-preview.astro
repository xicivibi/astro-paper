---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";
---

<Layout
  title={`CSV 파일 점검 도구 | ${config.site.title}`}
  description="CSV 파일을 업로드하지 않고 브라우저에서 구조와 일부 행을 확인하는 무료 도구입니다."
>
  <Header />
  <Main
    pageTitle="CSV 파일 점검 도구"
    pageDesc="파일을 서버로 보내지 않고 이 브라우저에서만 CSV 구조를 확인합니다."
  >
    <section class="border-border bg-muted/30 rounded border p-4 sm:p-6" aria-labelledby="csv-tool-title">
      <h2 id="csv-tool-title" class="text-lg font-bold">파일 선택</h2>
      <p class="text-muted-foreground mt-2 text-sm leading-6">최대 2MB까지 지원합니다. 원본 파일은 저장하거나 외부로 전송하지 않습니다.</p>
      <label for="csv-file" class="mt-4 block text-sm font-semibold">CSV 파일</label>
      <input id="csv-file" name="csv-file" type="file" accept=".csv,.tsv,text/csv,text/tab-separated-values,text/plain" class="border-border bg-background mt-2 block w-full rounded border p-2 text-sm" />
      <p id="csv-status" class="mt-3 text-sm" role="status" aria-live="polite">파일을 선택하면 점검 결과가 표시됩니다.</p>
      <p id="csv-error" class="mt-2 text-sm text-red-700 dark:text-red-300" role="alert" hidden></p>
    </section>

    <section id="csv-results" class="mt-6" aria-labelledby="csv-results-title" hidden>
      <h2 id="csv-results-title" class="text-lg font-bold">점검 결과</h2>
      <dl class="mt-3 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        <div class="border-border rounded border p-3"><dt class="text-muted-foreground text-xs">UTF-8 BOM</dt><dd id="csv-bom" class="mt-1 font-semibold"></dd></div>
        <div class="border-border rounded border p-3"><dt class="text-muted-foreground text-xs">내용이 있는 레코드 수</dt><dd id="csv-row-count" class="mt-1 font-semibold"></dd></div>
        <div class="border-border rounded border p-3"><dt class="text-muted-foreground text-xs">첫 행 열 수</dt><dd id="csv-column-count" class="mt-1 font-semibold"></dd></div>
        <div class="border-border rounded border p-3"><dt class="text-muted-foreground text-xs">가능성 높은 구분자</dt><dd id="csv-delimiter" class="mt-1 font-semibold"></dd></div>
      </dl>
      <ul id="csv-warnings" class="text-muted-foreground mt-4 list-disc space-y-1 ps-5 text-sm"></ul>
      <div class="mt-6 overflow-x-auto">
        <table id="csv-table" class="border-border w-full border-collapse border text-left text-sm">
          <caption class="text-muted-foreground mb-2 text-left">CSV 앞 20행 미리보기</caption>
          <thead id="csv-table-head"></thead>
          <tbody id="csv-table-body"></tbody>
        </table>
      </div>
    </section>
    <p class="text-muted-foreground mt-6 text-xs leading-5">개인정보 보호: 이 도구는 파일을 서버·분석 서비스·외부 API로 전송하지 않습니다. 인코딩은 BOM 여부 외에는 확정하지 않습니다.</p>
  </Main>
  <Footer />
</Layout>

<script>
  import { CSV_PREVIEW_MAX_BYTES, decodeCsvBytes, inspectCsv } from "@/utils/csvPreview";

  const fileInput = document.querySelector<HTMLInputElement>("#csv-file");
  const status = document.querySelector<HTMLElement>("#csv-status");
  const error = document.querySelector<HTMLElement>("#csv-error");
  const results = document.querySelector<HTMLElement>("#csv-results");
  const setText = (selector: string, value: string) => {
    const element = document.querySelector<HTMLElement>(selector);
    if (element) element.textContent = value;
  };
  const escapeHtml = (value: string) => value.replaceAll("&", "&amp;").replaceAll("<", "&lt;").replaceAll(">", "&gt;");

  fileInput?.addEventListener("change", async () => {
    const file = fileInput.files?.[0];
    if (!file) return;
    if (error) { error.hidden = true; error.textContent = ""; }
    if (results) results.hidden = true;
    if (file.size > CSV_PREVIEW_MAX_BYTES) {
      if (error) { error.hidden = false; error.textContent = "파일이 2MB를 초과합니다. 더 작은 CSV를 선택하세요."; }
      if (status) status.textContent = "점검을 중단했습니다.";
      return;
    }
    if (status) status.textContent = "브라우저에서 파일을 읽는 중입니다.";
    try {
      const decoded = decodeCsvBytes(new Uint8Array(await file.arrayBuffer()));
      const inspected = inspectCsv(decoded.text, decoded.hasUtf8Bom);
      setText("#csv-bom", inspected.hasUtf8Bom ? "있음" : "없음");
      setText("#csv-row-count", String(inspected.rowCount));
      setText("#csv-column-count", String(inspected.firstRowColumnCount));
      setText("#csv-delimiter", inspected.delimiterLabel);
      const warningList = document.querySelector<HTMLElement>("#csv-warnings");
      if (warningList) warningList.replaceChildren(...inspected.warnings.map(warning => { const li = document.createElement("li"); li.textContent = warning; return li; }));
      const head = document.querySelector<HTMLElement>("#csv-table-head");
      const body = document.querySelector<HTMLElement>("#csv-table-body");
      if (head) head.innerHTML = inspected.previewRows[0] ? `<tr>${inspected.previewRows[0].map((_, index) => `<th scope="col" class="border-border bg-muted/50 border p-2">열 ${index + 1}</th>`).join("")}</tr>` : "";
      if (body) body.innerHTML = inspected.previewRows.map(row => `<tr>${row.map(cell => `<td class="border-border border p-2 align-top whitespace-pre-wrap">${escapeHtml(cell)}</td>`).join("")}</tr>`).join("");
      if (results) results.hidden = false;
      if (status) status.textContent = "점검을 완료했습니다.";
    } catch {
      if (error) { error.hidden = false; error.textContent = "파일을 읽지 못했습니다. CSV 파일인지 확인하세요."; }
      if (status) status.textContent = "점검에 실패했습니다.";
    }
  });
</script>
