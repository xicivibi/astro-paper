---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import NewsItem from "@/components/NewsItem.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { slugifyStr } from "@/utils/slugify";
import { topics } from "@/config/topics";
import { getActiveTopicSummaries } from "@/utils/topicPosts";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const posts = await getCollection("posts", ({ data }) => !data.draft);
const sortedPosts = getSortedPosts(posts);
const latestPosts = sortedPosts.slice(0, Math.max(config.posts.perIndex, 30));
const latestPost = sortedPosts[0];
const latestDate = latestPost?.data.pubDatetime
  ? latestPost.data.pubDatetime.toLocaleDateString("ko-KR", {
      timeZone: config.site.timezone,
      year: "numeric",
      month: "short",
      day: "numeric",
    })
  : "준비 중";
const postsPath = getRelativeLocaleUrl(locale, "posts");
const searchPath = getRelativeLocaleUrl(locale, "search");
const topicsPath = getRelativeLocaleUrl(locale, "topics");
const toolsPath = getRelativeLocaleUrl(locale, "tools");
const excelTopicPath = getRelativeLocaleUrl(locale, "topics/excel-csv");
const activeTopics = getActiveTopicSummaries(sortedPosts, topics);
const allTags = sortedPosts.flatMap(post => post.data.tags ?? []);
const tagCount = allTags.reduce<Record<string, number>>((acc, tag) => {
  acc[tag] = (acc[tag] ?? 0) + 1;
  return acc;
}, {});
const topTags = Object.entries(tagCount)
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0], "ko"))
  .slice(0, 8);
---

<Layout>
  <Header />
  <main id="main-content" data-layout="index" class="app-layout py-4 sm:py-6">
    <section
      class="news-board border-border bg-background overflow-hidden border"
    >
      <div class="border-border bg-muted/55 border-b px-3 py-3 sm:px-4">
        <div
          class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between"
        >
          <div>
            <p
              class="text-accent text-xs font-bold tracking-[0.18em] uppercase"
            >
              WORK AUTOMATION LAB
            </p>
            <h1 class="mt-1 text-xl font-bold sm:text-2xl">
              Excel·CSV 실무 문제 해결
            </h1>
            <p class="text-muted-foreground mt-1 max-w-3xl text-sm leading-6">
              파일이 깨지거나 Power Query 결과가 달라질 때 바로 따라 할 수 있는
              절차를 제공합니다. 공식 문서, 재현 환경, 검토 날짜를 함께
              확인하세요.
            </p>
          </div>
          <dl
            class="grid grid-cols-3 gap-2 text-center text-xs sm:min-w-[280px]"
          >
            <div class="border-border bg-background border px-2 py-2">
              <dt class="text-muted-foreground">발행</dt>
              <dd class="font-bold">{sortedPosts.length}</dd>
            </div>
            <div class="border-border bg-background border px-2 py-2">
              <dt class="text-muted-foreground">업데이트</dt>
              <dd class="font-bold">{latestDate}</dd>
            </div>
            <div class="border-border bg-background border px-2 py-2">
              <dt class="text-muted-foreground">형식</dt>
              <dd class="font-bold">실무 가이드</dd>
            </div>
          </dl>
        </div>

        <nav
          class="mt-3 flex flex-wrap gap-2 text-xs font-semibold"
          aria-label="홈 바로가기"
        >
          <a
            href={postsPath}
            class="border-border bg-background hover:border-accent hover:text-accent border px-2.5 py-1.5 no-underline"
            >최신글</a
          >
          <a
            href={excelTopicPath}
            class="border-border bg-background hover:border-accent hover:text-accent border px-2.5 py-1.5 no-underline"
            >Excel·CSV 가이드</a
          >
          <a
            href={toolsPath}
            class="border-border bg-background hover:border-accent hover:text-accent border px-2.5 py-1.5 no-underline"
            >무료 도구</a
          >
          <a
            href={searchPath}
            class="border-border bg-background hover:border-accent hover:text-accent border px-2.5 py-1.5 no-underline"
            >검색</a
          >
          <a
            href="/briefs/"
            class="border-border bg-background hover:border-accent hover:text-accent border px-2.5 py-1.5 no-underline"
            >주간 브리프</a
          >
          <a
            href="/rss.xml"
            class="border-border bg-background hover:border-accent hover:text-accent border px-2.5 py-1.5 no-underline"
            >RSS</a
          >
        </nav>
      </div>

      {
        topTags.length > 0 && (
          <div class="border-border bg-background text-muted-foreground flex flex-wrap gap-x-3 gap-y-1 border-b px-3 py-2 text-xs sm:px-4">
            <span class="text-foreground font-semibold">Hot tags</span>
            {topTags.map(([tag, count]) => (
              <a
                href={`/tags/${slugifyStr(tag)}/`}
                class="hover:text-accent no-underline"
              >
                #{tag} <span class="text-[10px]">{count}</span>
              </a>
            ))}
          </div>
        )
      }

      {
        latestPosts.length > 0 ? (
          <ol class="divide-y-0">
            {latestPosts.map((post, index) => (
              <NewsItem {...post} index={index} />
            ))}
          </ol>
        ) : (
          <p class="text-muted-foreground px-4 py-10 text-sm">
            아직 발행된 글이 없습니다.
          </p>
        )
      }

      <div class="border-border bg-muted/45 border-t px-4 py-3 text-sm">
        <a href={postsPath} class="hover:text-accent font-semibold no-underline"
          >더 많은 글 보기</a
        >
        <span class="text-muted-foreground mx-2">|</span>
        <a
          href={searchPath}
          class="hover:text-accent font-semibold no-underline">검색으로 찾기</a
        >
      </div>
    </section>

    <section class="mt-6" aria-labelledby="topic-hubs-title">
      <div class="flex items-end justify-between gap-3">
        <div>
          <h2 id="topic-hubs-title" class="text-lg font-bold">주제 허브</h2>
          <p class="text-muted-foreground mt-1 text-sm">
            명시적으로 분류된 글만 주제별로 모읍니다.
          </p>
        </div>
        <a href={topicsPath} class="text-accent text-sm font-semibold"
          >모든 주제 →</a
        >
      </div>
      <ul class="mt-3 grid gap-3 sm:grid-cols-3">
        {
          activeTopics.map(({ topic, count }) => (
            <li class="border-border bg-background rounded border p-4">
              <a
                href={getRelativeLocaleUrl(locale, `topics/${topic.slug}`)}
                class="hover:text-accent font-bold no-underline"
              >
                {topic.title}
              </a>
              <p class="text-muted-foreground mt-2 text-sm leading-6">
                {topic.intro}
              </p>
              <p class="text-muted-foreground mt-3 text-xs">
                공개 글 {count}개
              </p>
            </li>
          ))
        }
      </ul>
      <a
        href={toolsPath}
        class="text-accent mt-3 inline-block text-sm font-semibold"
      >
        무료 업무 도구 보기 →
      </a>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", baseRoot);
    }
  });
</script>
