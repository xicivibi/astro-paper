---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import NewsItem from "@/components/NewsItem.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const posts = await getCollection("posts", ({ data }) => !data.draft);
const sortedPosts = getSortedPosts(posts);
const latestPosts = sortedPosts.slice(0, Math.max(config.posts.perIndex, 30));
const latestPost = sortedPosts[0];
const latestDate = latestPost?.data.pubDatetime
  ? latestPost.data.pubDatetime.toLocaleDateString("ko-KR", {
      year: "numeric",
      month: "short",
      day: "numeric",
    })
  : "준비 중";
const postsPath = getRelativeLocaleUrl(locale, "posts");
const listPath = getRelativeLocaleUrl(locale, "posts/list");
const tagsPath = getRelativeLocaleUrl(locale, "tags");
const searchPath = getRelativeLocaleUrl(locale, "search");
const allTags = sortedPosts.flatMap(post => post.data.tags ?? []);
const tagCount = allTags.reduce<Record<string, number>>((acc, tag) => {
  acc[tag] = (acc[tag] ?? 0) + 1;
  return acc;
}, {});
const topTags = Object.entries(tagCount)
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0], "ko"))
  .slice(0, 8);
---

<Layout>
  <Header />
  <main id="main-content" data-layout="index" class="app-layout py-4 sm:py-6">
    <section class="news-board overflow-hidden border border-border bg-background">
      <div class="border-b border-border bg-muted/55 px-3 py-3 sm:px-4">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <p class="text-xs font-bold tracking-[0.18em] text-accent uppercase">SEO News Board</p>
            <h1 class="mt-1 text-xl font-bold sm:text-2xl">AI SEO Lab 최신글</h1>
            <p class="mt-1 max-w-3xl text-sm leading-6 text-muted-foreground">
              트렌드, 검색 데이터, Fact Pack, 수익화 실험을 근거 중심으로 정리합니다. 카드보다 빠르게 읽히도록 최신 글을 뉴스 피드 형태로 보여줍니다.
            </p>
          </div>
          <dl class="grid grid-cols-3 gap-2 text-center text-xs sm:min-w-[280px]">
            <div class="border border-border bg-background px-2 py-2">
              <dt class="text-muted-foreground">발행</dt>
              <dd class="font-bold">{sortedPosts.length}</dd>
            </div>
            <div class="border border-border bg-background px-2 py-2">
              <dt class="text-muted-foreground">업데이트</dt>
              <dd class="font-bold">{latestDate}</dd>
            </div>
            <div class="border border-border bg-background px-2 py-2">
              <dt class="text-muted-foreground">형식</dt>
              <dd class="font-bold">뉴스보드</dd>
            </div>
          </dl>
        </div>

        <nav class="mt-3 flex flex-wrap gap-2 text-xs font-semibold" aria-label="홈 바로가기">
          <a href={postsPath} class="border border-border bg-background px-2.5 py-1.5 no-underline hover:border-accent hover:text-accent">최신글</a>
          <a href={listPath} class="border border-border bg-background px-2.5 py-1.5 no-underline hover:border-accent hover:text-accent">전체 리스트</a>
          <a href={tagsPath} class="border border-border bg-background px-2.5 py-1.5 no-underline hover:border-accent hover:text-accent">태그</a>
          <a href={searchPath} class="border border-border bg-background px-2.5 py-1.5 no-underline hover:border-accent hover:text-accent">검색</a>
        </nav>
      </div>

      {topTags.length > 0 && (
        <div class="flex flex-wrap gap-x-3 gap-y-1 border-b border-border bg-background px-3 py-2 text-xs text-muted-foreground sm:px-4">
          <span class="font-semibold text-foreground">Hot tags</span>
          {topTags.map(([tag, count]) => (
            <a href={`/tags/${tag}/`} class="no-underline hover:text-accent">
              #{tag} <span class="text-[10px]">{count}</span>
            </a>
          ))}
        </div>
      )}

      {latestPosts.length > 0 ? (
        <ol class="divide-y-0">
          {latestPosts.map((post, index) => <NewsItem {...post} index={index} />)}
        </ol>
      ) : (
        <p class="px-4 py-10 text-sm text-muted-foreground">아직 발행된 글이 없습니다.</p>
      )}

      <div class="border-t border-border bg-muted/45 px-4 py-3 text-sm">
        <a href={postsPath} class="font-semibold no-underline hover:text-accent">더 많은 글 보기</a>
        <span class="mx-2 text-muted-foreground">|</span>
        <a href={searchPath} class="font-semibold no-underline hover:text-accent">검색으로 찾기</a>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", baseRoot);
    }
  });
</script>
