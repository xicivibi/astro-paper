---
import Layout from "./Layout.astro";
import config from "@/config";

type Props = {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
  pubDatetime?: Date;
  modDatetime?: Date | null;
  author?: string;
  lastReviewed?: Date | null;
  sources?: string[];
  noindex?: boolean;
};

const { site } = config;

const {
  title,
  description,
  ogImage,
  canonicalURL,
  pubDatetime,
  modDatetime,
  author,
  lastReviewed,
  sources = [],
  noindex = false,
} = Astro.props;
const resolvedAuthor = author || site.author;
const authorType =
  resolvedAuthor === site.author ||
  /^AI(?:[- ]?Bot)?$/i.test(resolvedAuthor.trim())
    ? "Organization"
    : "Person";
const resolvedCanonicalURL = canonicalURL
  ? new URL(canonicalURL, Astro.site ?? site.url).href
  : new URL(Astro.url.pathname, Astro.site ?? site.url).href;

const structuredData = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title ?? site.title,
  ...(description && { description }),
  image: ogImage,
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": resolvedCanonicalURL,
  },
  ...(pubDatetime && { datePublished: pubDatetime.toISOString() }),
  ...(modDatetime && { dateModified: modDatetime.toISOString() }),
  author: [
    {
      "@type": authorType,
      name: resolvedAuthor,
      ...(site.profile && { url: site.profile }),
    },
  ],
  publisher: {
    "@type": "Organization",
    name: site.title,
    url: site.url,
  },
  inLanguage: site.lang,
  isPartOf: {
    "@type": "Blog",
    name: site.title,
    url: site.url,
  },
  ...(lastReviewed && { dateReviewed: lastReviewed.toISOString() }),
  ...(sources.length > 0 && { citation: sources }),
};
---

<Layout
  {title}
  {description}
  {ogImage}
  canonicalURL={resolvedCanonicalURL}
  pageType="article"
  {noindex}
>
  <Fragment slot="head">
    {
      pubDatetime && (
        <meta
          property="article:published_time"
          content={pubDatetime.toISOString()}
        />
      )
    }
    {
      modDatetime && (
        <meta
          property="article:modified_time"
          content={modDatetime.toISOString()}
        />
      )
    }

    {
      !noindex && (
        <script
          type="application/ld+json"
          is:inline
          set:html={JSON.stringify(structuredData).replaceAll("<", "\\u003c")}
        />
      )
    }
  </Fragment>

  <slot />
</Layout>
